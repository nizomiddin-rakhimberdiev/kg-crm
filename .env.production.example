# KG-CRM — ishlab chiqarish muhiti.
#
#   cp .env.production.example .env
#   # qiymatlarni to'ldiring, keyin:
#   ./scripts/deploy.sh
#
# Bu fayl NAMUNA — `.env` ning o'zi hech qachon git'ga tushmaydi.

# --- Domen ---
DOMAIN=kg-crm.uz
# Public sahifadagi footer/legal hujjatlarda ko'rsatiladigan yuridik
# shaxs nomi (MChJ, YaTT va h.k.). Bo'sh qoldirilsa shu qator bo'sh
# ko'rinadi — uydirma rekvizit yozilmaydi.
LEGAL_ENTITY_NAME=
PUBLIC_BASE_URL=https://kg-crm.uz
DJANGO_ALLOWED_HOSTS=kg-crm.uz,www.kg-crm.uz

# Mijoz manzili: `path` → /t/<slug>, `subdomain` → <slug>.kg-crm.uz.
# `subdomain` wildcard DNS va wildcard sertifikat talab qiladi.
TENANT_URL_STYLE=path

# --- Sirlar ---
#
# Har birini ALOHIDA yarating:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# DJANGO_SECRET_KEY JWT imzo kaliti hamdir — kamida 32 bayt bo'lishi
# SHART, aks holda server ishga tushmaydi (config/settings/production.py).
DJANGO_SECRET_KEY=

# Baza parollari — uchta rol, uchta parol (deploy/postgres/01-roles.sh).
OWNER_DB_PASSWORD=
APP_DB_PASSWORD=
BACKUP_DB_PASSWORD=

# --- Baza ---
POSTGRES_DB=kg_crm
POSTGRES_OWNER=kg_crm

# --- Muhit nomi ---
#
# Staging uchun bu qiymatni va PORTLARNI o'zgartiring — shunda bir xil
# serverda ikkita mustaqil stek ishlaydi (docs/deployment.md §10).
COMPOSE_PROJECT_NAME=kg-crm-prod

# --- Portlar ---
# Standart 80/443. Server oldida boshqa proxy tursa o'zgartiring.
HTTP_PORT=80
HTTPS_PORT=443

# TLS'ga haydash. `True` qoldiring. `False` faqat ikki holatda:
#   * birinchi deploy — sertifikat hali olinmagan (scripts/tls-setup.sh);
#   * TLS yuqorida tugaydi (load balancer, Cloudflare).
DJANGO_SECURE_SSL_REDIRECT=True

# --- Zaxira nusxa (scripts/backup.sh) ---
#
# Zaxirada bolalar va vasiylarning shaxsiy ma'lumoti bor. Server
# tashqarisiga chiqarilganda u ALBATTA shifrlangan bo'lishi kerak.
# Bu parolni zaxiralardan ALOHIDA saqlang — ikkalasini bir joyda
# saqlash shifrlashning ma'nosini yo'qotadi.
BACKUP_PASSPHRASE=
BACKUP_RETAIN_DAYS=14

# --- Bildirishnomalar ---
# `console` — SMS log'ga yoziladi (shlyuz hali ulanmagan).
NOTIFICATION_PROVIDER=console

# --- Loglash ---
LOG_LEVEL=INFO
