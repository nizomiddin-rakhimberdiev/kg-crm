# KG-CRM backend — muhit o'zgaruvchilari namunasi.
# Nusxa oling: cp .env.example .env   (.env HECH QACHON git'ga qo'shilmaydi)

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.development
# Kamida 32 bayt (JWT imzo kaliti ham shu).
# Yaratish: python -c "import secrets; print(secrets.token_urlsafe(48))"
DJANGO_SECRET_KEY=change-me-in-production-0123456789abcdef
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL ---
POSTGRES_DB=kg_crm
POSTGRES_USER=kg_crm
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis (cache + Celery broker) ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- JWT ---
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# --- CORS (frontend origin) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Vaqt zonasi va til ---
TIME_ZONE=Asia/Tashkent
LANGUAGE_CODE=uz

# --- SaaS / obuna (docs/01 §4) ---
# Diqqat: qiymat yonida izoh yozmang — django-environ uni qiymatning
# bir qismi deb o'qiydi va int() parsingi buziladi.
TRIAL_DAYS=15
# bank o'tkazmasi uchun to'liq kirish muhlati
PAYMENT_GRACE_DAYS=7
# ketgan mijozga faqat-o'qish + eksport muhlati
CHURN_EXPORT_RETENTION_DAYS=30

# --- Tashqi servislar (keyinroq) ---
SMS_PROVIDER_API_KEY=

# --- SMS: Eskiz.uz (Q8) ---
#
# Bo'sh bo'lsa `console` provayder ishlaydi va xabarlar "Test rejimi"
# holatida qoladi — ya'ni jurnal "yuborildi" deb yolg'on gapirmaydi.
# `ESKIZ_FROM` tasdiqlangan jo'natuvchi nomi bo'lishi SHART.
NOTIFICATION_PROVIDER=console
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=

# --- Telegram: yangi ariza ogohlantirishi (PLAN 3.6) ---
#
# Bo'sh bo'lsa ogohlantirish yuborilmaydi — ariza baribir saqlanadi.
# Chat ID guruh uchun manfiy bo'ladi: -1001234567890.
TELEGRAM_BOT_TOKEN=
TELEGRAM_LEAD_CHAT_ID=
