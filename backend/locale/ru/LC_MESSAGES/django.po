#, python-brace-format
msgid "Rasm hajmi {v} MB dan oshmasin."
msgstr "Размер фото не должен превышать {v} МБ."

#, python-brace-format
msgid "Faqat quyidagi formatlar: {allowed}."
msgstr "Допустимые форматы: {allowed}."

msgid "Kod lotin harflari va raqamlardan iborat boʻlsin."
msgstr "Код должен состоять из латинских букв и цифр."

msgid "Bu kod tashkilotda allaqachon mavjud."
msgstr "Такой код в организации уже есть."

msgid "Tizim rolining kodini oʻzgartirib boʻlmaydi."
msgstr "Код системной роли изменить нельзя."

msgid "Bu email tashkilotda allaqachon mavjud."
msgstr "Этот email в организации уже есть."

msgid "Org Ownerʼdan boshqa rollar uchun filial majburiy."
msgstr "Для всех ролей, кроме владельца, филиал обязателен."

msgid "Parol majburiy."
msgstr "Пароль обязателен."

msgid "Manzil (slug) boʻsh boʻlishi mumkin emas."
msgstr "Адрес (slug) не может быть пустым."

#, python-brace-format
msgid "'{candidate}' — band nom, boshqasini tanlang."
msgstr "«{candidate}» — зарезервированное имя, выберите другое."

#, python-brace-format
msgid "'{candidate}' allaqachon band."
msgstr "«{candidate}» уже занято."

msgid "Rol boshqa tashkilotga tegishli."
msgstr "Роль принадлежит другой организации."

msgid "Filial boshqa tashkilotga tegishli."
msgstr "Филиал принадлежит другой организации."

msgid "Org Ownerʼdan boshqa barcha rollar uchun filial koʻrsatilishi shart."
msgstr "Для всех ролей, кроме владельца, нужно указать филиал."

msgid "Yangi parol koʻrsatilmagan."
msgstr "Новый пароль не указан."

msgid "Bu maydon majburiy."
msgstr "Это поле обязательно."

msgid "Tizim rolini oʻchirib boʻlmaydi."
msgstr "Системную роль удалить нельзя."

#, python-brace-format
