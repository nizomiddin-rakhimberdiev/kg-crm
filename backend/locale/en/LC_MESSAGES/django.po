msgid "{employee}: ushlab qolish va avans ({taken}) naqd qismdan ({cash}) oshib ketdi. Rasmiy maoshni yoki avansni to'g'rilang."
msgstr "{employee}: deductions and the advance ({taken}) exceed the cash part ({cash}). Adjust the official salary or the advance."

msgid "Bu kunlar uchun da'vo allaqachon bor: {date_from} — {date_to}."
msgstr "A claim already covers these days: {date_from} — {date_to}."

msgid "Bu oraliqda bog'cha ishlamagan (dam olish yoki bayram) — qaytariladigan kun yo'q."
msgstr "The kindergarten was closed for this whole range (weekend or holiday) — nothing to credit."

msgid "Da'vo '{status}' holatida — rad etib bo'lmaydi."
msgstr "The claim is '{status}' — it cannot be rejected."

msgid "Da'vo '{status}' holatida — tasdiqlab bo'lmaydi."
msgstr "The claim is '{status}' — it cannot be approved."

msgid "Hisob-fakturaga tushdi"
msgstr "Applied to an invoice"

msgid "Kelmagan kunlar uchun qayta hisob: {days} kun × {rate}"
msgstr "Credit for days missed: {days} days × {rate}"

msgid "Ota-ona arizasi"
msgstr "Parent's application"

msgid "Shifokor ma'lumotnomasi"
msgstr "Doctor's certificate"

msgid "Tugash sanasi boshlanishdan oldin bo'lolmaydi."
msgstr "The end date cannot be earlier than the start date."

msgid "{full_name}: tarif ham, hisob-faktura ham yo'q."
msgstr "{full_name}: there is neither a tariff nor an invoice."

msgid "{year}-{month:02d} oyida ish kuni yo'q — kalendarni tekshiring."
msgstr "{year}-{month:02d} has no working days — check the calendar."

msgid "`period_year` va `period_month` butun son bo'lishi kerak."
msgstr "`period_year` and `period_month` must be whole numbers."

msgid "{full_name}: sozlamaga ko'ra birinchi hisob-faktura keyingi oydan yoziladi."
msgstr "{full_name}: per the settings, the first invoice starts from next month."

msgid "{month}, {total} ish kunidan {attended} kun"
msgstr "{month}, {attended} of {total} working days"

msgid "Ombor xaridi"
msgstr "Stock purchase"

msgid "{product} — {quantity} {unit}"
msgstr "{product} — {quantity} {unit}"

msgid "Telefon raqamini {hint} formatida kiriting."
msgstr "Enter the phone number as {hint}."

msgid "24 soatdan eski yozuv"
msgstr "record older than 24 hours"

msgid "Bola yoshi {min}–{max} oralig'ida bo'lishi kerak."
msgstr "The child's age must be between {min} and {max}."

msgid "Bu bolani o'chirib bo'lmaydi ({reasons}). Uni ARXIVGA oling — ma'lumot saqlanadi, ro'yxatlardan chiqadi."
msgstr "This child cannot be deleted ({reasons}). ARCHIVE them instead — the data is kept and they leave the lists."

msgid "Holatni o'zgartirish uchun sabab yozing."
msgstr "Give a reason for the status change."

msgid "Noma'lum holat."
msgstr "Unknown status."

msgid "Sana kelajakda bo'la olmaydi."
msgstr "The date cannot be in the future."

