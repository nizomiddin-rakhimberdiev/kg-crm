msgid "Summa yoki debet/kredit ustunlarini tanlang."
msgstr "Выберите столбец суммы или дебета/кредита."

msgid "Koʻchirma faqat bank hisobiga yuklanadi."
msgstr "Выписка загружается только на банковский счёт."

msgid "Faylda summa va sanasi bor qator topilmadi."
msgstr "В файле нет строк с суммой и датой."

msgid "Faqat chiqim qatoridan xarajat yaratiladi."
msgstr "Расход создаётся только из строки списания."

msgid "Toifa topilmadi."
msgstr "Категория не найдена."

msgid "Faqat kirim qatoridan toʻlov yaratiladi."
msgstr "Оплата создаётся только из строки поступления."

msgid "Ustunlar moslashtirilmagan."
msgstr "Столбцы не сопоставлены."

msgid "Qator topilmadi."
msgstr "Строка не найдена."

msgid "Toifani tanlang."
msgstr "Выберите категорию."
