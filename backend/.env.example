# KG-CRM backend — muhit o'zgaruvchilari namunasi.
# Nusxa oling: cp .env.example .env   (.env HECH QACHON git'ga qo'shilmaydi)

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL ---
POSTGRES_DB=kg_crm
POSTGRES_USER=kg_crm
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis (cache + Celery broker) ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- JWT ---
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# --- CORS (frontend origin) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Vaqt zonasi va til ---
TIME_ZONE=Asia/Tashkent
LANGUAGE_CODE=uz

# --- SaaS / obuna (docs/01 §4) ---
TRIAL_DAYS=15
PAYMENT_GRACE_DAYS=7           # bank o'tkazmasi uchun to'liq kirish muhlati
CHURN_EXPORT_RETENTION_DAYS=30 # ketgan mijozga faqat-o'qish + eksport muhlati

# --- Tashqi servislar (keyinroq) ---
SMS_PROVIDER_API_KEY=
