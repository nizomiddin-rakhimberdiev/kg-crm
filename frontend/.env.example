# Frontend muhit o'zgaruvchilari.
# Nusxa oling: cp .env.example .env

# Backend API manzili
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# --- Obuna to'lovi rekvizitlari (PLAN 1.12) ---
#
# Obuna sahifasidagi "Qanday to'lash" bloki. Bo'sh bo'lsa blok umuman
# ko'rsatilmaydi — noto'g'ri rekvizit ko'rsatishdan ko'ra hech narsa
# ko'rsatmagan yaxshi. Ko'p qatorli matn bo'lishi mumkin.
VITE_PAYMENT_BANK_DETAILS=
VITE_PAYMENT_CONTACT=

# --- Yuridik shaxs (PLAN 5.7, 5.8) ---
#
# Public saytning footer'i va huquqiy sahifalar shu qiymatlarni
# ko'rsatadi. Bo'sh bo'lsa — ko'rsatilmaydi (saytda "{{STIR}}" kabi
# to'ldirilmagan yozuv chiqmasin). Production'da `compose.prod.yaml`
# ularni `.env` dan BUILD argumenti sifatida uzatadi.
VITE_LEGAL_ENTITY_NAME=
VITE_LEGAL_TIN=
VITE_LEGAL_ADDRESS=
# Serverlar joylashuvi — maxfiylik siyosatida (PLAN 5.8).
VITE_SERVER_LOCATION=

# --- Brauzerdagi E2E (PLAN 11.8) ---
#
# Testlar YOZADI (bola qo'shadi, to'lov qabul qiladi), shuning uchun
# ular DEMO stendiga qarshi ishlaydi. Mijoz stendini bu yerga
# yozmang.
E2E_BASE_URL=https://radix-crm.uz/private
E2E_EMAIL=
E2E_PASSWORD=
