msgstr "Payroll {period}: {employee}"

msgid "Rasmiy (bank)"
msgstr "Official (bank)"

msgid "Toʻlanadigan summa yoʻq."
msgstr "There is nothing to pay out."

msgid "oylik qayta ochildi"
msgstr "payroll run reopened"

msgid "{employee}: toʻlov summasi hisoblangandan oshib ketdi ({total} > {allowed})."
msgstr "{employee}: the payout exceeds what was calculated ({total} > {allowed})."

msgid "{employee}: ushlab qolish va avans ({taken}) naqd qismdan ({cash}) oshib ketdi. Rasmiy maoshni yoki avansni toʻgʻrilang."
msgstr "{employee}: deductions and the advance ({taken}) exceed the cash part ({cash}). Adjust the official salary or the advance."

msgid "Bu kunlar uchun daʼvo allaqachon bor: {date_from} — {date_to}."
msgstr "A claim already covers these days: {date_from} — {date_to}."

msgid "Bu oraliqda bogʻcha ishlamagan (dam olish yoki bayram) — qaytariladigan kun yoʻq."
msgstr "The kindergarten was closed for this whole range (weekend or holiday) — nothing to credit."

msgid "Daʼvo '{status}' holatida — rad etib boʻlmaydi."
msgstr "The claim is '{status}' — it cannot be rejected."

msgid "Daʼvo '{status}' holatida — tasdiqlab boʻlmaydi."
msgstr "The claim is '{status}' — it cannot be approved."

msgid "Hisob-fakturaga tushdi"
msgstr "Applied to an invoice"

msgid "Kelmagan kunlar uchun qayta hisob: {days} kun × {rate}"
msgstr "Credit for days missed: {days} days × {rate}"

msgid "Ota-ona arizasi"
msgstr "Parent's application"

msgid "Shifokor maʼlumotnomasi"
msgstr "Doctor's certificate"

msgid "Tugash sanasi boshlanishdan oldin boʻlolmaydi."
msgstr "The end date cannot be earlier than the start date."

msgid "{full_name}: tarif ham, hisob-faktura ham yoʻq."
msgstr "{full_name}: there is neither a tariff nor an invoice."

msgid "{year}-{month:02d} oyida ish kuni yoʻq — kalendarni tekshiring."
msgstr "{year}-{month:02d} has no working days — check the calendar."

msgid "`period_year` va `period_month` butun son boʻlishi kerak."
msgstr "`period_year` and `period_month` must be whole numbers."

msgid "{full_name}: sozlamaga koʻra birinchi hisob-faktura keyingi oydan yoziladi."
msgstr "{full_name}: per the settings, the first invoice starts from next month."

msgid "{month}, {total} ish kunidan {attended} kun"
msgstr "{month}, {attended} of {total} working days"

msgid "Ombor xaridi"
msgstr "Stock purchase"

msgid "{product} — {quantity} {unit}"
msgstr "{product} — {quantity} {unit}"

msgid "Telefon raqamini {hint} formatida kiriting."
msgstr "Enter the phone number as {hint}."

msgid "24 soatdan eski yozuv"
msgstr "record older than 24 hours"

msgid "Bola yoshi {min}–{max} oraligʻida boʻlishi kerak."
msgstr "The child's age must be between {min} and {max}."

msgid "Bu bolani oʻchirib boʻlmaydi ({reasons}). Uni ARXIVGA oling — maʼlumot saqlanadi, roʻyxatlardan chiqadi."
msgstr "This child cannot be deleted ({reasons}). ARCHIVE them instead — the data is kept and they leave the lists."

msgid "Holatni oʻzgartirish uchun sabab yozing."
msgstr "Give a reason for the status change."

msgid "Nomaʼlum holat."
msgstr "Unknown status."

msgid "Sana kelajakda boʻla olmaydi."
msgstr "The date cannot be in the future."

msgid "davomat"
msgstr "attendance"

msgid "hisob-faktura"
msgstr "invoice"

msgid "moliyaviy yozuv"
msgstr "financial record"

msgid "toʻlov"
msgstr "payment"

msgid "Bu guruh sizga biriktirilmagan — davomatni belgilay olmaysiz."
msgstr "This group is not assigned to you — you cannot mark its attendance."

msgid "Oʻtgan kun davomatini oʻzgartirish uchun sabab yozing."
msgstr "Give a reason for changing a past day's attendance."

msgid "Tarbiyachi faqat oxirgi {days} kun davomatini belgilaydi. Eski kun uchun direktorga murojaat qiling."
msgstr "A teacher may only mark the last {days} day(s). For earlier days, ask the director."

msgid "Test rejimi"
msgstr "Test mode"

msgid "Notoʻgʻri raqam"
msgstr "Invalid number"

msgid "Telefon raqami yoʻq"
msgstr "No phone number"

msgid "Notoʻgʻri identifikator."
msgstr "Invalid identifier."

msgid "{field}: raqam notoʻgʻri."
msgstr "{field}: invalid number."

msgid "Qiymat"
msgstr "Value"

msgid "Kunlar"
msgstr "Days"

msgid "SMS provayderi sozlanmagan."
msgstr "The SMS provider is not configured."

msgid "Oʻzbekcha"
msgstr "Uzbek"

msgid "Ruscha"
msgstr "Russian"

msgid "Inglizcha"
msgstr "English"

msgid "Telegram ulanmagan"
msgstr "Telegram is not connected"

msgid "Ota-ona botni bloklagan"
msgstr "The parent has blocked the bot"

msgid "Fayl tanlanmagan."
msgstr "No file selected."

msgid "Fayl 2 MB dan kichik boʻlishi kerak."
msgstr "The file must be smaller than 2 MB."

msgid "PNG, JPG, WEBP yoki SVG yuboring."
msgstr "Send a PNG, JPG, WEBP or SVG."

msgid "Juda koʻp urinish. {minutes} daqiqadan keyin qayta urinib koʻring."
msgstr "Too many attempts. Try again in {minutes} min."

msgid "Agar bu email tizimda boʻlsa, tiklash havolasi yuborildi. Pochtangizni tekshiring."
msgstr "If that e-mail is in the system, a reset link has been sent. Please check your inbox."

msgid "Havola eskirgan yoki ishlatilgan. Yangisini soʻrang."
msgstr "The link has expired or has already been used. Request a new one."

msgid "Parol oʻzgartirildi. Endi kirishingiz mumkin."
msgstr "Your password has been changed. You can sign in now."

msgid "Radix CRM — parolni tiklash"
msgstr "Radix CRM — password reset"

msgid "Radix CRM"
msgstr "Radix CRM"

msgid "Assalomu alaykum, {name}!\n\n{organization} hisobingiz uchun parolni tiklash soʻrovi keldi.\nYangi parol oʻrnatish uchun havolani bosing:\n\n{link}\n\nHavola {minutes} daqiqa ishlaydi va bir marta ishlatiladi.\nAgar bu soʻrovni siz yubormagan boʻlsangiz — hech narsa qilish kerak emas, parolingiz oʻzgarmaydi."
msgstr "Hello, {name}!\n\nWe received a password reset request for your {organization} account.\nOpen this link to set a new password:\n\n{link}\n\nThe link works for {minutes} minutes and can be used once.\nIf you did not ask for this, no action is needed — your password stays the same."

msgid "Soʻrov tasdiqlanmadi. Sahifani yangilang."
msgstr "The request was not verified. Refresh the page."


# Taklif havolasi (PLAN 5.5)
msgid "Radix CRM — bogʻchangiz tayyor"
msgstr "Radix CRM — your kindergarten is ready"

msgid "Assalomu alaykum, {name}!\n\n{organization} uchun Radix CRM hisobi ochildi.\nParolni oʻzingiz oʻrnatasiz — havolani bosing:\n\n{link}\n\nHavola {hours} soat ishlaydi. Parolni hech kimga aytmang: biz ham uni bilmaymiz va soʻramaymiz."
msgstr "Hello, {name}!\n\nA Radix CRM account has been opened for {organization}.\nYou set the password yourself — open the link:\n\n{link}\n\nThe link works for {hours} hours. Do not share the password with anyone: we do not know it either and will never ask."

msgid "Havola eskirgan yoki ishlatilgan. Vendordan yangisini soʻrang."
msgstr "The link has expired or has already been used. Ask the vendor for a new one."

msgid "Parol oʻrnatildi. Endi kirishingiz mumkin."
msgstr "Password set. You can sign in now."


# Ikki bosqichli tasdiqlash (PLAN 5.4, ADR-24)
msgid "Ikki bosqichli tasdiqlash oʻchirildi."
msgstr "Two-factor authentication has been turned off."

msgid "Ikki bosqichli tasdiqlash yoqilmagan."
msgstr "Two-factor authentication is not enabled."

msgid "Kod notoʻgʻri yoki eskirgan."
msgstr "The code is wrong or has expired."

msgid "Kod notoʻgʻri. Ilovadagi joriy kodni kiriting."
msgstr "The code is wrong. Enter the current code from your app."

msgid "Parol notoʻgʻri."
msgstr "Wrong password."

# --- ADR-25: delegatsiya qoidasi, filial tanlovi ---

msgid "Bu bogʻchada bir nechta filial bor — avval yuqoridagi filial tanlovidan kerakli filialni tanlang."
msgstr "This kindergarten has several branches — first choose the branch in the selector at the top."

msgid "Bu rolda sizda yoʻq ruxsatlar bor, shuning uchun uni bera olmaysiz: {codes}."
msgstr "This role includes permissions you do not have, so you cannot assign it: {codes}."

msgid "Faqat oʻz filialingizga xodim qoʻsha olasiz."
msgstr "You can only add staff to your own branch."

msgid "Oʻz hisobingizni Profil sahifasida tahrirlang."
msgstr "Edit your own account on the Profile page."

msgid "Oʻz rolingizning ruxsatlarini oʻzgartira olmaysiz."
msgstr "You cannot change the permissions of your own role."

msgid "Rol kodini yaratilgandan keyin oʻzgartirib boʻlmaydi."
msgstr "A role's code cannot be changed after it is created."

msgid "Sizda yoʻq ruxsatlarni bera olmaysiz: {codes}."
msgstr "You cannot grant permissions you do not have: {codes}."

msgid "Sizdan kengroq huquqli rolni oʻzgartira olmaysiz."
msgstr "You cannot change a role with broader permissions than yours."

msgid "Sizdan kengroq huquqli xodimning hisobini boshqara olmaysiz."
msgstr "You cannot manage the account of a staff member with broader permissions than yours."

msgid "Tashkilot egasi rolini faqat tashkilot egasi bera oladi."
msgstr "Only the organization owner can assign the owner role."

msgid "Tashkilot egasi rolini faqat tashkilot egasi oʻzgartira oladi."
msgstr "Only the organization owner can change the owner role."

msgid "Tashkilot egasining hisobini faqat egasi boshqara oladi."
msgstr "Only the owner can manage the organization owner's account."

# --- Individual narx (2026-10) ---

msgid "Individual narx"
msgstr "Individual price"

msgid "Tarif yoki individual narx — faqat bittasini tanlang."
msgstr "Tariff or individual price — choose only one."

msgid "{full_name}: narx belgilanmagan (tarif ham, individual narx ham yoʻq) — hisob-faktura chiqarib boʻlmaydi."
msgstr "{full_name}: no price set (neither a tariff nor an individual price) — an invoice cannot be issued."

msgid "{full_name}: narx ham, hisob-faktura ham yoʻq."
msgstr "{full_name}: there is neither a price nor an invoice."

msgid "Faqat oʻz filialingizda yozuv yarata olasiz."
msgstr "You can only create records in your own branch."

